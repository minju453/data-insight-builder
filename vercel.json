{
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,api/templates/**,api/static/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__vercel_path=/$1"
    }
  ]
}
