# Gemini API Key (https://aistudio.google.com/ 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (코드에 하드코딩하지 않고 환경변수로 지정)
# 예시: gemini-2.5-flash, gemini-1.5-flash 등
GEMINI_MODEL=gemini-3.5-flash-lite

# Flask 디버그 모드 (true / false)
FLASK_DEBUG=true

# 최대 업로드 파일 크기 (MB 단위)
MAX_UPLOAD_MB=10
